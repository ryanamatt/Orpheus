# Orpheus configuration file
# Generated by --gen-config. Uncomment and edit any setting you want to
# change - lines are shown commented-out with their default value.
# See CONFIGURATION.md for the full reference.

# Spaces per Tab keypress.
#tab_width=4

# 0 hides the line-number gutter, any other value shows it.
#show_line_numbers=1

# Non-zero copies the leading whitespace of the current line on Enter.
#auto_indent=1

# 0 hides the status/command bar, giving one extra row of text.
#show_statusbar=1

# Terminal cursor shape: 0=invisible 1=normal 2=block.
#cursor_style=1

# Built-in colour theme: default | dark | light | mono
#color_scheme=default

# Width, in columns, of the line-number gutter.
#gutter_width=5

# Escape-sequence processing delay, in milliseconds.
#key_delay=50

# 1 starts the editor in focus/typewriter mode (Ctrl-T toggles it).
#focus_mode=0

# Text column width used in focus mode.
#focus_width=72

# strftime() format for {{currentTime}} in templates.
# %-m/%-d (no leading zero) are glibc extensions; fall back to
# %m/%d on non-glibc systems (e.g. macOS/BSD libc) if this looks wrong.
#time_format=%-m/%-d/%y

# Per-pair colour overrides, layered on top of color_scheme above.
# Recognised values: black, red, green, yellow, blue, magenta, cyan,
# white, default. Unset keys keep whatever color_scheme assigns.
#color_normal_fg=default
#color_normal_bg=default
#color_status_fg=default
#color_status_bg=default
#color_cmdbar_fg=default
#color_cmdbar_bg=default
#color_lnum_fg=default
#color_lnum_bg=default
#color_search_fg=default
#color_search_bg=default
#color_select_fg=default
#color_select_bg=default
