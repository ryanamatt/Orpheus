# This is a comment

tab_width=4
show_line_numbers=1
auto_indent=1
show_statusbar=1
wrap_long_lines=1

cursor_style=2
color_scheme=default

# Optional per-pair colour overrides - applied on top of color_scheme above.
# Uncomment and edit any of these to tweak individual UI colours without
# abandoning the scheme. Recognised values: black, red, green, yellow, blue,
# magenta, cyan, white, default. See docs/CONFIGURATION.md for the full list
# of available keys.
# color_search_bg=magenta
# color_lnum_fg=green
